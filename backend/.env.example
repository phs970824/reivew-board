PORT=4000

# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=restaurant_board

# Supabase 배포 시: DATABASE_URL을 넣으면 위 DB_* 대신 이걸 씁니다.
# Transaction pooler URI + DB_SSL=true 권장
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# DB_SSL=true

JWT_SECRET=change-this-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
